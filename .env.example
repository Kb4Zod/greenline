# Greenline local configuration
# Copy to `.env` and adjust. `.env` is git-ignored and must NEVER be committed.
# Every value here is optional — the app runs with the defaults shown.

# Where live data (SQLite DB, import staging) lives. Defaults to a per-user
# app-data folder OUTSIDE the repo tree:
#   Windows: %LOCALAPPDATA%\Greenline
#   macOS/Linux: ~/.greenline
# GREENLINE_DATA_DIR=

# Database filename inside the data dir.
# GREENLINE_DB_FILENAME=greenline.sqlite3

# API bind address/port (local only — never expose this).
# GREENLINE_API_HOST=127.0.0.1
# GREENLINE_API_PORT=8537

# Display name. "Greenline" is a working codename (decision 0008);
# keep the name configurable so the eventual rename is painless.
# GREENLINE_APP_NAME=Greenline
